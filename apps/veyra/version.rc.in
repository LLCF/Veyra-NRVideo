#include <windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/apps/veyra/resource.h"
IDI_VEYRA ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/veyra.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "Veyra Video Player"
   VALUE "FileVersion", "@VEYRA_DISPLAY_VERSION@"
   VALUE "ProductName", "Veyra"
   VALUE "ProductVersion", "@VEYRA_DISPLAY_VERSION@"
   VALUE "OriginalFilename", "Veyra.exe"
   VALUE "LegalCopyright", "Veyra contributors. GPL-3.0."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
