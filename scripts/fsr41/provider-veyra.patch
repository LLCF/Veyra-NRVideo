+bool Provider::RecordZeroFrameState(ID3D12GraphicsCommandList* cl, std::string* err) {
+    // Immutable descriptors; reset executes in-order on the caller queue.
+    ID3D12Resource* resources[] = {scratch_, histTex_, recTex_, reprojTex_, aeTex_};
+    if (!clearHeap_) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd{};
+        hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        hd.NumDescriptors = 5;
+        if (FAILED(device_->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&clearCpuHeap_))))
+            FSR411_THROW(err, "create reset CPU heap");
+        hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        if (FAILED(device_->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&clearHeap_))))
+            FSR411_THROW(err, "create reset GPU heap");
+        auto cpu = clearCpuHeap_->GetCPUDescriptorHandleForHeapStart();
+        auto gpuCpu = clearHeap_->GetCPUDescriptorHandleForHeapStart();
+        for (int i = 0; i < 5; ++i) {
+            D3D12_UNORDERED_ACCESS_VIEW_DESC view{};
+            view.Format = resources[i]->GetDesc().Format;
+            view.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+            if (i == 0) {
+                view.Format = DXGI_FORMAT_R32_TYPELESS;
+                view.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+                view.Buffer.NumElements = UINT(kScratchSize / 4);
+                view.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+            }
+            device_->CreateUnorderedAccessView(resources[i], nullptr, &view, cpu);
+            device_->CopyDescriptorsSimple(1, gpuCpu, cpu, hd.Type);
+            cpu.ptr += descriptorSize_; gpuCpu.ptr += descriptorSize_;
+        }
+    }
+    cl->SetDescriptorHeaps(1, &clearHeap_);
+    auto cpu = clearCpuHeap_->GetCPUDescriptorHandleForHeapStart();
+    auto gpu = clearHeap_->GetGPUDescriptorHandleForHeapStart();
+    for (int i = 0; i < 5; ++i) {
+        UAVBarrier(cl, resources[i]);
+        const UINT zeros[4] = {};
+        const float ones[4] = {1, 1, 1, 1};
+        if (i == 4) cl->ClearUnorderedAccessViewFloat(gpu, cpu, resources[i], ones, 0, nullptr);
+        else cl->ClearUnorderedAccessViewUint(gpu, cpu, resources[i], zeros, 0, nullptr);
+        UAVBarrier(cl, resources[i]);
+        cpu.ptr += descriptorSize_; gpu.ptr += descriptorSize_;
+    }
+    return true;
+}
